# wendococr ortam değişkenleri
# Kopyala: cp .env.example .env

# Geçici dosya dizini
UPLOAD_DIR=/tmp/wendococr

# Limitler
MAX_FILE_SIZE_MB=50
MAX_PAGES=500

# Logging
LOG_LEVEL=INFO
DEBUG=false

# CORS (virgülle ayrılmış; * = tümü)
CORS_ORIGINS=*

# OCR (opsiyonel) — Türkçe diacritik koruma için min 200 DPI
OCR_DPI_RAPID=200
OCR_DPI_TESSERACT=250
OCR_DPI_PADDLEOCR_LOW=200

# ICR — El Yazısı Tanıma (opsiyonel)
ICR_DPI=300

# Tesseract Türkçe (opsiyonel)
TESSERACT_PSM=3
TESSERACT_DESKEW=false
TESSERACT_THRESHOLD=false
TESSERACT_ENHANCE=true
TESSERACT_USER_DEFINED_DPI=300

# RapidOCR (pdfimagev5) (opsiyonel)
RAPIDOCR_THRESHOLD=false
RAPIDOCR_ENHANCE=true

# ── Redis (opsiyonel guvenlik) ──────────────────────────────────────
# Standalone (docker-compose.redis.yml) kullaniyorsan parola koyabilirsin:
#   REDIS_PASSWORD=<openssl rand -hex 16>
# Parola koyarsan REDIS_URL'i de parolali ver (app o URL'i kullanir):
#   REDIS_URL=redis://:<ayni-parola>@redis:6379/1?socket_timeout=10
# Ikisi de bos ise parolasiz calisir. Dis paylasimli redis'e parola EKLEME.
# REDIS_PASSWORD=
# REDIS_URL=
