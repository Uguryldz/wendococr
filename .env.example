# wendococr ortam değişkenleri
# Kopyala: cp .env.example .env

# Geçici dosya dizini
UPLOAD_DIR=/tmp/wendococr

# Limitler
MAX_FILE_SIZE_MB=50
MAX_PAGES=500

# Logging
LOG_LEVEL=INFO
DEBUG=false

# CORS (virgülle ayrılmış; * = tümü)
CORS_ORIGINS=*

# OCR (opsiyonel)
OCR_DPI_RAPID=150
OCR_DPI_TESSERACT=150

# Tesseract Türkçe (opsiyonel)
TESSERACT_PSM=3
TESSERACT_DESKEW=false
TESSERACT_THRESHOLD=false
TESSERACT_ENHANCE=false
# Boş bırakılırsa eklenmez. Örn: 300
TESSERACT_USER_DEFINED_DPI=

# RapidOCR (pdfimagev5) (opsiyonel)
RAPIDOCR_THRESHOLD=false
RAPIDOCR_ENHANCE=true
