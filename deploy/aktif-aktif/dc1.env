# DC1 — 8 CPU / 16 GB RAM
# Bütçe: 10 worker × 1.2G + API 1.5G + OS ~2G ≈ 15.5G (limit; gerçek kullanım boşta ~3 GB, yükte ~11 GB)
WENDOCOCR_VERSION=v1.1.6

# Ortak Valkey (iki DC'de AYNI). Parola ve host'u kendi Valkey'ine göre değiştir.
# ACL kullanıcısı: redis://KULLANICI:SIFRE@host:6379/1  (şifrede @:/#?% varsa URL-kodla, $ -> $$)
# TLS: rediss://...?ssl_cert_reqs=none   |  RESP3 bilmeyen proxy: ...?protocol=2
REDIS_URL=redis://:CHANGE_ME@valkey.ornek.local:6379/1

API_BIND=0.0.0.0
API_CPUS=1.5
API_MEM=1500M

WORKER_REPLICAS=10
WORKER_CPUS=1.5
WORKER_MEM=1200M

# Kuyruk ORTAK: bu değerler iki DC'de aynı olmalı.
# Tüm anahtarlar bu önekle başlar (ACL: ~wendococr:*). Cluster modunda {wendococr} yaz.
REDIS_KEY_PREFIX=wendococr
OCR_QUEUE_MAX_SIZE=500
OCR_QUEUE_TIMEOUT=600
REDIS_RESULT_TTL=900
