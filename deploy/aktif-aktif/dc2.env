# DC2 — 8 CPU / 24 GB RAM
# Bütçe: 10 worker × 2G + API 2G + OS ~2G = 24G (limit; büyük taranmış PDF'lere daha fazla pay)
WENDOCOCR_VERSION=v1.1.9

# Ortak Valkey (iki DC'de AYNI). Biçim için dc1.env'deki açıklamaya bak.
REDIS_URL=redis://:CHANGE_ME@valkey.ornek.local:6379/1

API_BIND=0.0.0.0
API_CPUS=2.0
API_MEM=2G

WORKER_REPLICAS=10
WORKER_CPUS=1.5
WORKER_MEM=2G

# Kuyruk ORTAK: bu değerler iki DC'de aynı olmalı.
# Tüm anahtarlar bu önekle başlar (ACL: ~wendococr:*). Cluster modunda {wendococr} yaz.
REDIS_KEY_PREFIX=wendococr
OCR_QUEUE_MAX_SIZE=500
OCR_QUEUE_TIMEOUT=600
REDIS_RESULT_TTL=900
